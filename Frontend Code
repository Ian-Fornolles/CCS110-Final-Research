function openSessionNowForm() {
  if (!db.computers.length) return showMessage('No Computers', 'Add a computer in the Computer Section first.');
  if (computerOptions({ onlyAvailable: true }).length < 2) return showMessage('No Computers Available', 'Every computer is occupied or reserved right now.');

  const selected = findComputer(app.selectedComputer);
  const prefill = selected && getComputerStatus(selected) === 'Available' ? selected.id : '';
  const fields = [
    ...personFields(),
    { id: 'computerId', label: 'Computer:', type: 'select', options: computerOptions({ onlyAvailable: true }), rule: required('Computer selection') }
  ];

  formModal({
    title: 'Start Session Now', fields, values: { computerId: prefill }, submitLabel: 'Start Session',
    onSubmit: v => {
      const pc = findComputer(v.computerId);
      if (!pc || getComputerStatus(pc) !== 'Available') {
        showMessage('Computer Unavailable', 'That computer is no longer available. Choose another.', '❌');
        return false;
      }
      const customer = newCustomer(v, pc.id, 'Session Now');
      db.customers.push(customer);
      db.sessions.push({ id: uid(), customerId: customer.id, computerId: pc.id, startTime: new Date().toISOString() });
      saveData();
      renderCurrentView();
    }
  });
}

function openReservationForm() {
  if (!db.computers.length) return showMessage('No Computers', 'Add a computer in the Computer Section first.');
  const toDate = (d, t) => new Date(`${d}T${t}`);

  const fields = [
    ...personFields(),
    { id: 'computerId', label: 'Computer:', type: 'select', options: computerOptions(), rule: required('Computer selection'), linked: ['endTime'] },
    { id: 'date', label: 'Reservation Date:', type: 'date', attrs: `min="${todayStr()}"`, linked: ['startTime', 'endTime'],
      rule: v => v === '' ? 'Reservation date is required.' : v < todayStr() ? 'Date cannot be in the past.' : true },
    { id: 'startTime', label: 'Start Time:', type: 'time', linked: ['endTime'],
      rule: (v, root) => v === '' ? 'Start time is required.'
        : (val(root, 'date') === todayStr() && toDate(todayStr(), v) < new Date()) ? 'Start time has already passed.' : true },
    { id: 'endTime', label: 'End Time:', type: 'time',
      rule: (v, root) => {
        const start = val(root, 'startTime'), date = val(root, 'date'), pc = val(root, 'computerId');
        if (v === '') return 'End time is required.';
        if (start && v <= start) return 'End time must be after the start time.';
        if (start && date && pc) {
          const clash = db.reservations.find(r => r.computerId === pc && r.date === date && start < r.endTime && v > r.startTime);
          if (clash) return `Already reserved ${clash.startTime}-${clash.endTime} on that date.`;
        }
        return true;
      } }
  ];

  const overlay = formModal({
    title: 'Reserve Computer', fields, width: 520, submitLabel: 'Reserve',
    values: { computerId: app.selectedComputer || '', date: todayStr() },
    onSubmit: v => {
      const customer = newCustomer(v, v.computerId, 'Reservation');
      db.customers.push(customer);
      db.reservations.push({ id: uid(), customerId: customer.id, computerId: v.computerId, date: v.date, startTime: v.startTime, endTime: v.endTime });
      saveData();
      renderCurrentView();
    }
  });
  $('.mbody', overlay).classList.add('cols');
}

function endSession(id) {
  const session = db.sessions.find(s => s.id === id);
  if (!session) return;

  confirmDialog('End Session', `End the session of ${customerName(session.customerId)} on ${computerName(session.computerId)}?`, () => {
    const endTime = new Date();
    const durationMs = endTime - new Date(session.startTime);
    const pc = findComputer(session.computerId);
    const fee = pc ? pc.rate * durationMs / 3600000 : 0;
    const customer = findCustomer(session.customerId);

    db.history.unshift({
      id: uid(),
      customerId: session.customerId,
      customerName: customerName(session.customerId),
      computerName: computerName(session.computerId),
      startTime: session.startTime,
      endTime: endTime.toISOString(),
      durationMs,
      fee
    });
    if (customer) customer.rentalFee = (customer.rentalFee || 0) + fee;
    db.sessions = db.sessions.filter(s => s.id !== id);

    saveData();
    renderCurrentView();
    showMessage('Session Ended',
      `Customer: ${customerName(session.customerId)}\nComputer: ${computerName(session.computerId)}\nDuration: ${formatDuration(durationMs)}\nRental fee: ${money(fee)}`, '✅');
  });
}

function cancelReservation(id) {
  const r = db.reservations.find(x => x.id === id);
  if (!r) return;
  confirmDialog('Cancel Reservation', `Cancel the reservation of ${customerName(r.customerId)} for ${computerName(r.computerId)}?`, () => {
    db.reservations = db.reservations.filter(x => x.id !== id);
    saveData();
    renderCurrentView();
