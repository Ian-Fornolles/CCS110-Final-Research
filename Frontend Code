  <script>
    'use strict';

/* ================= Config ================= */
const STORAGE_KEYS = {
  computers: 'unity.computers',
  customers: 'unity.customers',
  sessions: 'unity.sessions',
  reservations: 'unity.reservations',
  history: 'unity.history'
};

const COMPUTER_TYPES = {
  Standard: { rate: 2.0, specs: 'Core i3, 8GB RAM, 256GB SSD' },
  Gaming:   { rate: 4.0, specs: 'Core i7, 16GB RAM, RTX 3060' },
  VIP:      { rate: 6.0, specs: 'Core i9, 32GB RAM, RTX 4080' }
};

const VIEW_TITLES = { home: 'Home Page', computers: 'Computer Section', customers: 'Customer Section' };

/* ================= State ================= */
const accounts = {
  owner: { username: '', password: '' },
  staff: { username: '', password: '' }
};

const db = { computers: [], customers: [], sessions: [], reservations: [], history: [] };
const app = { view: 'home', selectedComputer: null, user: null, role: null, ticks: 0 };

/* Assign from the console, e.g. assignAccount('owner', 'boss', 'secret') */
function assignAccount(role, username, password) {
  if (!accounts[role]) throw new Error('Role must be "owner" or "staff".');
  Object.assign(accounts[role], { username: String(username), password: String(password) });
  return `Account assigned for ${role}`;
}
window.assignAccount = assignAccount;

/* ================= Helpers ================= */
const $ = (selector, root = document) => root.querySelector(selector);
const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const pad = n => String(n).padStart(2, '0');
const money = n => '$' + Number(n || 0).toFixed(2);
const val = (root, id) => root.querySelector('#f_' + id).value;

const todayStr = () => { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };
const formatDuration = ms => { const s = Math.max(0, Math.floor(ms / 1000)); return `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s % 3600 / 60))}:${pad(s % 60)}`; };
const formatDateTime = iso => new Date(iso).toLocaleString();

const findComputer = id => db.computers.find(c => c.id === id);
const findCustomer = id => db.customers.find(c => c.id === id);
const computerName = id => findComputer(id)?.name ?? '—';
const customerName = id => findCustomer(id)?.fullName ?? 'Unknown';

/* ================= Storage ================= */
const createDefaultComputers = () => Object.entries({ Standard: 6, Gaming: 3, VIP: 1 }).flatMap(([type, count]) =>
  Array.from({ length: count }, () => ({ type, ...COMPUTER_TYPES[type] }))
).map((pc, i) => ({ id: uid() + i, name: `PC-${pad(i + 1)}`, type: pc.type, specs: pc.specs, rate: pc.rate }));

function readList(key) {
  try {
    const parsed = JSON.parse(localStorage.getItem(key));
    return Array.isArray(parsed) ? parsed : [];
  } catch (err) {
    console.error('Failed to read', key, err);
    return [];
  }
}

function loadData() {
  const firstRun = localStorage.getItem(STORAGE_KEYS.computers) === null;
  Object.keys(db).forEach(name => { db[name] = readList(STORAGE_KEYS[name]); });
  if (firstRun) {
    db.computers = createDefaultComputers();
    saveData();
  }
}

function saveData() {
  try {
    Object.keys(db).forEach(name => localStorage.setItem(STORAGE_KEYS[name], JSON.stringify(db[name])));
  } catch (err) {
    console.error(err);
    showMessage('Storage Error', 'UNITY could not save data to this browser. Storage may be full or disabled.', '❌');
  }
}

/* ================= Modals ================= */
function openModal({ title, body, buttons = [], width = 420, cls = '' }) {
  const overlay = document.createElement('div');
  overlay.className = 'overlay';
  overlay.innerHTML = `
    <div class="window modal ${cls}" style="width:${width}px">
      <div class="titlebar">
        <span class="tt">${esc(title)}</span>
        <div class="tbtns"><button type="button" class="tb close" title="Close">✕</button></div>
      </div>
      <div class="wbody"><div class="mbody">${body}</div><div class="mfoot"></div></div>
    </div>`;

  const win = $('.modal', overlay);
  const footer = $('.mfoot', overlay);

  buttons.forEach(b => {
    const el = document.createElement('button');
    el.type = 'button';
    el.className = 'xp-btn' + (b.primary ? ' default' : '');
    el.textContent = b.label;
    if (b.primary) el.dataset.primary = '1';
    el.onclick = () => {
      try {
        if (!b.handler || b.handler(overlay) !== false) overlay.remove();
      } catch (err) {
        console.error(err);
        showMessage('Error', 'Something went wrong: ' + err.message, '❌');
      }
    };
    footer.appendChild(el);
  });

  $('.tb.close', overlay).onclick = () => overlay.remove();
  overlay.addEventListener('keydown', e => {
    if (e.key === 'Escape') overlay.remove();
    if (e.key === 'Enter' && e.target.tagName === 'INPUT') $('[data-primary]', overlay)?.click();
  });

  $('.titlebar', overlay).addEventListener('mousedown', e => {
    if (e.target.closest('button')) return;
    const startX = e.clientX - (win._x || 0), startY = e.clientY - (win._y || 0);
    const move = ev => {
      win._x = ev.clientX - startX;
      win._y = ev.clientY - startY;
      win.style.transform = `translate(${win._x}px, ${win._y}px)`;
    };
    const up = () => { document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); };
    document.addEventListener('mousemove', move);
    document.addEventListener('mouseup', up);
  });

  $('#modalRoot').appendChild(overlay);
  ($('input,select,.xp-btn', $('.mbody', overlay)) || $('.xp-btn', overlay))?.focus();
  return overlay;
}

