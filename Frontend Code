  return [
    { id: 'name', label: 'Computer Name:', type: 'text', attrs: 'maxlength="30"',
      rule: v => !v.trim() ? 'Computer name is required.' : nameTaken(v) ? 'A computer with this name already exists.' : true },
    { id: 'type', label: 'Type:', type: 'select', options: Object.keys(COMPUTER_TYPES).map(t => [t, t]) },
    { id: 'specs', label: 'Specifications:', type: 'text', attrs: 'maxlength="80"', rule: required('Specifications') },
    { id: 'rate', label: 'Hourly Rate ($):', type: 'number', attrs: 'min="0" step="0.01"',
      rule: v => (v !== '' && +v > 0 && +v <= 1000) || 'Enter an hourly rate greater than 0.' }
  ];
}

function openComputerForm(id) {
  const existing = id ? findComputer(id) : null;
  if (id && !existing) return showMessage('Not Found', 'That computer no longer exists.', '❌');
