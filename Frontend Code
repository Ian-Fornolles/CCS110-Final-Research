      else db.computers.push({ id: uid(), ...data });
      saveData();
      renderCurrentView();
    }
  });
}

function deleteComputer(id) {
  const pc = findComputer(id);
  if (!pc) return;
  if (db.sessions.some(s => s.computerId === id)) {
    return showMessage('Cannot Delete', `${pc.name} has an active session. End the session first.`, '❌');
  }
  confirmDialog('Confirm Delete', `Are you sure you want to delete "${pc.name}"?\nIts reservations will also be removed.`, () => {
    db.computers = db.computers.filter(c => c.id !== id);
    db.reservations = db.reservations.filter(r => r.computerId !== id);
    db.customers.forEach(c => { if (c.computerId === id) c.computerId = ''; });
    if (app.selectedComputer === id) app.selectedComputer = null;
    saveData();
    renderCurrentView();
  });
}

